# Copy to .env and fill. .env is gitignored - this repo is public and is linked
# in the deck, and a key in git history is a bad day.

# --- LLM (free tiers only; no paid inference in this project) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Reddit: OAuth script app, ~3 minutes to register at
#     https://www.reddit.com/prefs/apps  (gives 100 QPM, well above what is needed)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ajio-engine/0.1 by u/YOUR_USERNAME

# --- YouTube Data API v3, free 10,000 units/day ---
YOUTUBE_API_KEY=
