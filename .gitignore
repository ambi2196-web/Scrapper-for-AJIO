# --- secrets ---
.env
.env.*
!.env.example
*.key
.streamlit/secrets.toml

# --- scraped corpus: NOT committed ---
# The repo is public. data/out/ and data/dashboard/ carry the aggregated
# artifacts the deck and the dashboard read; the corpus itself stays local.
data/raw/*
data/interim/*
data/labelled/*
# All hand-labelling working files, by SHAPE rather than by extension.
# `data/gold/*.csv` was the first attempt and it leaked: the labelled sheet
# arrived as .xlsx and was tracked for eight days. Ignoring the directory
# contents catches whatever format the next one shows up in.
#
# These carry 100 rows of scraped review text - working data, not a
# deliverable. Only data/out/ and the dashboard snapshot ship (see B5).
# CODEBOOK.md is exempt: it is generated documentation with no corpus text.
data/gold/*
!data/gold/.gitkeep
!data/gold/CODEBOOK.md
logs/deferred/
logs/*.jsonl

# Keep the shape of the tree visible on a fresh clone.
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/labelled/.gitkeep
!data/gold/.gitkeep
!logs/.gitkeep

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# --- os / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- local tooling ---
.claude/
